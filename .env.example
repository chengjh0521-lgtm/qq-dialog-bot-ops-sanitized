# QQ 开放平台凭证：仅填写在本机 .env，绝不能提交。
QQ_APP_ID=
QQ_APP_SECRET=
QQ_SANDBOX=true

# 可选：兼容 OpenAI Chat Completions 的对话模型。
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
SYSTEM_PROMPT=你是一个友好、可靠、回答简洁的 QQ 助手。请使用中文回答。

# 可选：QQ 邮箱 SMTP 通知。填写授权码，不要填写 QQ 登录密码。
QQ_EMAIL_SMTP_HOST=smtp.qq.com
QQ_EMAIL_SMTP_PORT=465
QQ_EMAIL_USE_SSL=true
QQ_EMAIL_SENDER=
QQ_EMAIL_AUTH_CODE=
QQ_EMAIL_RECIPIENTS=
